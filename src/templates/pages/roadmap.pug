extends ../layouts/layout.pug

block title
  | Roadmap

block content
  .roadmap
    .container
      .roadmap__title ROADMAP
      .roadmap__subtitle
        | Crafting the future of the blockchain connectivity and
        br
        | communication with unmatched scalability, privacy, and utility.
      .roadmap__content
        .roadmap__content-item.roadmap__content-item--data
          |2Q 2024
          br
          |April
        .roadmap__content-item.roadmap__content-item--chat.dark Protocol architecture design
        .roadmap__content-item.roadmap__content-item--chat Token functions and utility design
        .roadmap__content-item.roadmap__content-item--chat Approval of the raise structure, raise size, and company valuation within each of the rounds
        .roadmap__content-item.roadmap__content-item--chat.dark Creation of materials (deck/onepager) that will be used in B2B sales
        .roadmap__content-item.roadmap__content-item--data May
        .roadmap__content-item.roadmap__content-item--chat.dark Creation of a website landing page
        .roadmap__content-item.roadmap__content-item--chat Creation of a pitch deck for communication with launchpads and private investors
        .roadmap__content-item.roadmap__content-item--chat.dark Identification of key partners and potential customers for conducting custdev interviews
        .roadmap__content-item.roadmap__content-item--chat Communication with potential customers and partners as part of custdev interviews to identify interest in the service and test hypotheses regarding optimal pricing
        .roadmap__content-item.roadmap__content-item--data June
        .roadmap__content-item.roadmap__content-item--chat.dark Finalization of the list of launchpads
        .roadmap__content-item.roadmap__content-item--chat.dark Finalization of the list of centralized exchanges
        .roadmap__content-item.roadmap__content-item--chat Finalization of the list of influencers
        .roadmap__content-item.roadmap__content-item--chat.dark Launch of the marketing campaign dedicated to the token launch
        .roadmap__content-item.roadmap__content-item--chat.dark Public round raise on launchpads
        .roadmap__content-item.roadmap__content-item--chat Token launch on a centralized exchange
        .roadmap__content-item.roadmap__content-item--data
          |3Q
          br
          |2024
        .roadmap__content-item.roadmap__content-item--chat.dark MVP with ecosystem partner
