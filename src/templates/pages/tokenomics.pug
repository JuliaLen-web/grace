extends ../layouts/layout.pug

block title
  | Token and Tokenomics

block content
  .tokenomics
    .container
      section.tokenomics__section
        h1.tokenomics__title What is the &#x20;
          span GRACE TOKEN?
        .tokenomics__subtitle $GRACE cryptocurrency is the native utility token of the GRACE Ecosystem.
        .tokenomics__blocks.tokenomics__blocks--heroblock
          .tokenomics__blocks-item
            .tokenomics__blocks-item-type Token ticker
            .tokenomics__blocks-item-info $GRACE
          .tokenomics__blocks-item
            .tokenomics__blocks-item-type Token name
            .tokenomics__blocks-item-info GRACE
      section.tokenomics__section
        .tokenomics__section-supertitle TOKEN UTILITY
        .separate-line
        h2.tokenomics__section-title UNIFYING TOKEN ACROSS WEB3 MARKETS UNDER ONE SAFE, CAPITAL&#8209;EFFICIENT MULTI&#8209;CHAIN PROTOCOL
        .tokenomics__section-subtitle Grace provides its token holders with the following use cases:
        .tokenomics__blocks.tokenomics__blocks--vertical
          .tokenomics__blocks-item
            .tokenomics__blocks-item-image
              img(src=require('@/assets/img/content/utility-1.png') alt="")
            .tokenomics__blocks-item-title Grow
            .tokenomics__blocks-item-text Stakers of $GRACE get access to regular benefits and value sharefrom new ecosystem apps and infrastructure partners
          .tokenomics__blocks-item
            .tokenomics__blocks-item-image
              img(src=require('@/assets/img/content/utility-2.png') alt="")
            .tokenomics__blocks-item-title Stake
            .tokenomics__blocks-item-text Lock $GRACE tokens on DEXs and benefit from competitive APRs
          .tokenomics__blocks-item
            .tokenomics__blocks-item-image
              img(src=require('@/assets/img/content/utility-3.png') alt="")
            .tokenomics__blocks-item-title Simplify
            .tokenomics__blocks-item-text Use $GRACE as a direct payment method for Grace Net integration fees, subscription services, and access to special events or developer tools. This utility ensures constant demand for token within the ecosystem
      section.tokenomics__section.tokenomics__section--graph
        .tokenomics__section-supertitle TOKEN DISTRIBUTION
        .separate-line
        h2.tokenomics__section-title ECOSYSTEM CENTRED
        .tokenomics__section-subtitle The largest portion of the token supply is designated for the ecosystem and distributed as part of a strategic plan to promote robust ecosystem development.
        include ../components/graph
      section.tokenomics__section.tokenomics__section--statistics
        h2.tokenomics__section-title TOKEN SUPPLY AND CIRCULATION
        .tokenomics__blocks
          .tokenomics__blocks-item
            .tokenomics__blocks-item-type Max supply
            .tokenomics__blocks-item-info 5 000 000 000
          .tokenomics__blocks-item
            .tokenomics__blocks-item-type Total supply
            .tokenomics__blocks-item-info 5 000 000 000
        .overflow-scroll
          .tokenomics__chart
            include ../components/chart
        .overflow-scroll
          .tokenomics__table
            table
              thead
                tr
                  td Stage
                  td Seed
                  td Private
                  td Public
              tbody
                tr
                  td Price
                  td 0.05
                  td 0.09
                  td 0.25
                tr
                  td Discount from public
                  td 400.00%
                  td 177.78%
                  td 0.00%
                tr
                  td Amount raised
                  td $30,000,000
                  td $45,000,000
                  td $125,000,000
                tr
                  td Fully diluted valuation
                  td $250,000,000
                  td $450,000,000
                  td $1,250,000,000
                tr
                  td Tokens Sold
                  td 600,000,000
                  td 500,000,000
                  td 500,000,000
                tr
                  td Percent of supply
                  td 12.00%
                  td 10.00%
                  td 10.00%
                tr
                  td Release on TGE (%)
                  td 12.00%
                  td 8.00%
                  td 50.00%
                tr
                  td Release on TGE ($)
                  td $18,000,000
                  td $10,000,000
                  td $62,500,000
                tr
                  td Release on TGE (q-ty)
                  td 40,000,000
                  td 250,000,000
                  td 250,000,000
        a(href="#").button Tokenomics Spreadsheet
