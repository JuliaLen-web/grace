form.form-subscribe#form-subscribe
  .form-subscribe__input
    input(placeholder="E-mail..." type="email" name="email" required)
    .form-invalid Please enter your e-mail
  button(type="submit" disabled).button.form-subscribe__submit Subscribe
  .form-subscribe__checkbox
    label(for="checkbox")
      input(type="checkbox" id="checkbox" checked required)
      .form-subscribe__checkbox-label
        | By submitting your contact information, you agree to receive communications from our team about products, services, and events. You may unsubscribe from these updates at any time. Please see our &#x20;
        a(href="#") Privacy Policy &#x20;
        |for more information.
      .form-subscribe__checkbox-control
